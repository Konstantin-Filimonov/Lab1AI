# Скопируйте этот файл в .env и при необходимости отредактируйте.
# LM Studio поднимает локальный OpenAI-совместимый сервер.
# По умолчанию: Settings -> Developer -> Local Server -> Start Server (порт 1234).

# Ключ LM Studio не проверяет, но библиотека openai требует непустую строку.
LLM_API_KEY=lm-studio

# Базовый адрес локального сервера LM Studio.
LLM_BASE_URL=http://localhost:1234/v1

# Имя модели ДОЛЖНО совпадать с тем, что LM Studio отдаёт в /v1/models
# (обычно это путь/идентификатор модели, который вы видите в LM Studio при загрузке).
# Узнать точное имя: curl http://localhost:1234/v1/models
LLM_MODEL=model-name-from-lm-studio

# Человекочитаемое имя модели для таблиц результатов (можно писать вручную).
LLM_MODEL_LABEL=Model A
